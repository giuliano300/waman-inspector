
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>WAMAN - Login</title>

    <!--favicon-->
    <link rel="apple-touch-icon" sizes="57x57" href="/Images/Favicon/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/Images/Favicon/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/Images/Favicon/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/Images/Favicon/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/Images/Favicon/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/Images/Favicon/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/Images/Favicon/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/Images/Favicon/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/Images/Favicon/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/Images/Favicon/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/Images/Favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/Images/Favicon/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/Images/Favicon/favicon-16x16.png">
    <link rel="manifest" href="/Images/Favicon/manifest.json">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="/Images/Favicon/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
    <!--end favicon-->

    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    <link href="https://maxst.icons8.com/vue-static/landings/line-awesome/line-awesome/1.3.0/css/line-awesome.min.css" rel="stylesheet">
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/style.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/jquery")

</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col-md-3"></div>
            <div class="col-md-6">

                <div class="container-login">

                    <div class="login-logo">
                        <img src="~/Images/Logo.png" alt="Waman" />
                    </div>

                    <div class="login-form">
                        <form action="" method="post" onsubmit="return false">
                            <ul>
                                <li>
                                    <input type="email" placeholder="Email" required name="email" class="email" />
                                </li>
                                <li>
                                    Enter your login email to recover your password.<br />
                                    If you know your credentials instead <a href="/Home/Index"><strong>click here</strong></a><br /> to return to login.
                                </li>
                                <li>
                                    <input type="submit" value="RESTORE PASSWORD" class="mt-20" onclick="RequestChange()" />
                                </li>
                                <li class="mt-40 textsize-5">Problems with login?<br />contact the administrator at <a href="mailto:info@waman.app"><strong>info@waman.app</strong></a></li>
                            </ul>
                        </form>
                    </div>

                </div>

                <div class="login-footer">
                    © @DateTime.Now.Year - WAMAN <a href="mailto:info@waman.app">info@waman.app</a>.
                </div>

            </div>
            <div class="col-md-3"></div>
        </div>

    </div>

    <div class="modal fade" id="confirmModalRequest" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="confirmModalLabel">Request Sended</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="modal-r">

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>


    <script>
        function RequestChange() {

            if ($('.email').val() == "")
                return false;

            $.get('/Home/RequestChangePwd?email=' + $('.email').val(), function (res) {
                if (res)
                    OnSuccess();
                else
                    OnFailure();
            })
        }

        function OnSuccess() {
            $('.email').val('');
            $('#confirmModalRequest').modal('show');
            $('#modal-r').html('We have sent an email to your address for the password recovery procedure.');
        }

        function OnFailure() {
            $('.email').val('');
            $('#confirmModalRequest').modal('show');
            $('#modal-r').html('There was an error sending the request. Please try again!');
        }
    </script>
</body>
</html>
