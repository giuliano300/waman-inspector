
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WAMAN - Change password</title>

    <link rel="preload" href="/Content/phosphor/Phosphor.woff2" as="font" type="font/woff2" crossorigin />
    <link href="/Content/phosphor/style.css?ver=2.1.2" rel="stylesheet" />
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/style.css" rel="stylesheet" />
    <link href="~/Content/inspector-v3.css?ver=7.4" rel="stylesheet" />

    <!--favicon-->
    <link rel="apple-touch-icon" sizes="57x57" href="/Images/Favicon/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/Images/Favicon/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/Images/Favicon/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/Images/Favicon/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/Images/Favicon/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/Images/Favicon/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/Images/Favicon/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/Images/Favicon/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/Images/Favicon/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/Images/Favicon/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/Images/Favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/Images/Favicon/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/Images/Favicon/favicon-16x16.png">
    <link rel="manifest" href="/Images/Favicon/manifest.json">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="/Images/Favicon/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
    <!--end favicon-->

    @Scripts.Render("~/bundles/jquery")

</head>
<body class="auth-page">
    <aside class="auth-brand">
        <a href="/" class="auth-brand__logo"><img src="~/Images/Logo.png" alt="Waman" width="190" height="72" /></a>
        <div class="auth-brand__copy">
            <span>Account security</span>
            <h1>Create a secure new password.</h1>
            <p>Use at least eight characters with uppercase, lowercase and a number.</p>
        </div>
        <div class="auth-brand__footer">&copy; @DateTime.Now.Year District Operations Ltd</div>
    </aside>

    <main class="auth-panel">
        <section class="auth-card">
            <a href="/" class="auth-mobile-logo"><img src="~/Images/Logo.png" alt="Waman" width="150" height="57" /></a>
            <span class="auth-card__eyebrow">Password reset</span>
            <h2>Choose a password</h2>
            <p class="auth-card__intro">Enter and confirm your new inspector account password.</p>
            <form action="" method="post" onsubmit="return validatePassword();">
                <div class="auth-field">
                    <label for="pwd">New password</label>
                    <div class="auth-field__control"><i class="ph ph-lock-key ui-icon"></i><input type="password" placeholder="Enter new password" id="pwd" required name="pwd" autocomplete="new-password" /></div>
                    <small id="pwdError" class="error-message" style="color: #a83f3f; display: none;">Use at least 8 characters, one uppercase, one lowercase and one number.</small>
                </div>
                <div class="auth-field">
                    <label for="newPwd">Confirm password</label>
                    <div class="auth-field__control"><i class="ph ph-lock-key ui-icon"></i><input type="password" placeholder="Repeat new password" id="newPwd" required name="newPwd" autocomplete="new-password" /></div>
                    <small id="newPwdError" class="error-message" style="color: #a83f3f; display: none;">The passwords do not match.</small>
                </div>
                <button type="submit" class="auth-submit">Update password</button>
                <p class="auth-back">Need help? <a href="mailto:info@waman.app">Contact the administrator</a></p>
                <input type="hidden" name="g" value="@ViewBag.g" class="g" />
            </form>
        </section>
    </main>


    <div class="modal fade" id="confirmModalRequest" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="confirmModalLabel">Password update</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="modal-r">

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>

    <script>
        function validatePassword() {
            const password = document.getElementById("pwd").value;
            const confirmPassword = document.getElementById("newPwd").value;

            const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/;

            const pwdError = document.getElementById("pwdError");
            const newPwdError = document.getElementById("newPwdError");
            pwdError.style.display = "none";
            newPwdError.style.display = "none";

            if (!passwordRegex.test(password)) {
                pwdError.style.display = "block";
                return false;
            }

            if (password !== confirmPassword) {
                newPwdError.style.display = "block";
                return false;
            }

            return ChangePwd();
        }


        function ChangePwd() {

            $.get('/Home/SaveChangePwd?pwd=' + $('#pwd').val() + "&guid=" + $('.g').val(), function (res) {
                if (res)
                    OnSuccess();
                else
                    OnFailure();
            })

            return false;
        }



        function OnSuccess() {
            $('#pwd').val('');
            $('#newPwd').val('');
            $('#modal-r').html('The password has been successfully changed.<br><a href="/">Return to login</a>');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmModalRequest')).show();
        }

        function OnFailure() {
            $('#pwd').val('');
            $('#newPwd').val('');
            $('#modal-r').html('There was an error sending the request. Please try again!');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmModalRequest')).show();
        }
    </script>
    @Html.Partial("_AppFooter")
</body>
</html>
