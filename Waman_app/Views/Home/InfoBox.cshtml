@using Waman_app.Models
@model List<InfoBoxToInspectors>

@{
    ViewBag.Title = "InfoBox";
}

<div class="page-heading page-hero">
    <div>
        <span class="page-heading__eyebrow">Notices and updates</span>
        <h1>Info box</h1>
        <p>Operational information shared with inspectors.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        @if (Model != null && Model.Any())
        {
            foreach (var info in Model.OrderByDescending(i => i.date))
            {
                <div class="info-box">
                    <h2>
                        <span>@info.date.ToString("MMM").ToUpper()</span><br />
                        @info.date.Day
                    </h2>
                    <section>
                        <h4>@info.name</h4>
                        <p>@Html.Raw(info.description)</p>
                    </section>
                </div>
            }
        }
        else
        {
            <div class="empty-state info-empty"><i class="ph ph-chat-teardrop-text ui-icon"></i><h2>Nothing new</h2><p>No information is available right now.</p></div>
        }
    </div>
</div>
