@model List<Waman_app.Models.CompleteInspectorPlanning>
@using Waman_app.Models
@using Newtonsoft.Json
@using System.Globalization

@{
    ViewBag.Title = "Dashboard";
    var today = DateTime.Today;

    var inspectorsCookie = Request.Cookies["Inspectors"]?.Value;
    var inspector = inspectorsCookie != null ? JsonConvert.DeserializeObject<Inspectors>(inspectorsCookie) : null;
    var inspectorIdCookie = inspector != null ? inspector.id : 0;
    var todayPlans = Model != null
        ? Model.Where(item => item.inspectorPlanning.date.Date == today && !item.inspectorPlanning.closed).OrderBy(a => a.inspectorPlanning.time).ToList()
        : new List<CompleteInspectorPlanning>();
}

<section class="dashboard-hero page-hero">
    <div class="dashboard-hero__copy">
        <span class="page-heading__eyebrow">@today.ToString("dddd, dd MMMM yyyy", CultureInfo.InvariantCulture)</span>
        <h1>Good morning, @(inspector != null ? inspector.name : "Inspector")</h1>
        @if (todayPlans.Any())
        {
            <p>You have <strong>@todayPlans.Count</strong> @(todayPlans.Count == 1 ? "inspection" : "inspections") scheduled today.</p>
        }
        else
        {
            <p>Your schedule is clear for today.</p>
        }
    </div>
    <div class="dashboard-hero__mark" aria-hidden="true">
        <span></span><span></span><span></span>
    </div>
</section>

<section class="quick-actions" aria-label="Quick actions">
    <div class="quick-action">
        @if (ViewBag.HasTodayInspections)
        {
            <a href="/Home/InspectionPlan" class="enabled">
                <span class="quick-action__icon"><i class="ph ph-calendar-check ui-icon"></i></span>
                <span class="quick-action__copy"><strong>Today's plan</strong><small>Open your inspection schedule</small></span>
                <i class="ph ph-caret-right ui-icon quick-action__arrow"></i>
            </a>
        }
        else
        {
            <div class="quick-action__link disabled" aria-disabled="true" title="No inspections available for today">
                <span class="quick-action__icon"><i class="ph ph-calendar-x ui-icon"></i></span>
                <span class="quick-action__copy"><strong>Today's plan</strong><small>No inspections scheduled</small></span>
            </div>
        }
    </div>
    <div class="quick-action">
        <a href="/Home/InspectionArchive">
            <span class="quick-action__icon"><i class="ph ph-archive ui-icon"></i></span>
            <span class="quick-action__copy"><strong>Archive</strong><small>Review completed inspections</small></span>
            <i class="ph ph-caret-right ui-icon quick-action__arrow"></i>
        </a>
    </div>
    <div class="quick-action">
        <a href="/Home/InfoBox">
            <span class="quick-action__icon"><i class="ph ph-chat-teardrop-text ui-icon"></i></span>
            <span class="quick-action__copy"><strong>Info box</strong><small>Read notices and updates</small></span>
            <i class="ph ph-caret-right ui-icon quick-action__arrow"></i>
        </a>
    </div>
</section>

<section class="content-card schedule-card">
    <div class="content-card__header">
        <div>
            <span class="content-card__eyebrow">Schedule</span>
            <h2>Today's inspections</h2>
        </div>
        @if (todayPlans.Any())
        {
            <a href="/Home/InspectionPlan" class="text-link">View plan <i class="ph ph-arrow-right ui-icon"></i></a>
        }
    </div>
    <div class="content-card__body">
        <div class="row">
            <div class="col-md-12">
            <div class="site-table site-table-dashboard">
                <ul class="site-table__top">
                    <li style="width:13%;"><span>DATE</span></li>
                    <li style="width:10%;"><span>TIME</span></li>
                    <li style="width:30%;"><span>LOCATION</span></li>
                    <li style="width:47%;"><span>ADDRESS</span></li>
                </ul>
                @if (Model != null && Model.Any())
                {
                    if (todayPlans.Any())
                    {
                        foreach (var item in todayPlans)
                        {
                            //var fullAddress = $"{item.location.name} {item.location.address}, {item.city.name}";
                            var fullAddress = $"{item.location.address}, {item.city.name}";
                            var locationName = $"{item.location.name}";

                            <ul class="inspection-item" data-inspection-id="@item.inspectorPlanning.id" data-fulladdress="@fullAddress" data-locationname="@locationName">
                                <li style="width:13%;">@item.inspectorPlanning.date.ToString("dd/MM/yyyy")</li>
                                <li style="width:10%;">@item.inspectorPlanning.time.ToString(@"hh\:mm")</li>
                                <li style="width:30%;"><strong class="color-blue">@item.location.name</strong></li>
                                <li style="width:47%;">@item.location.address - @item.city.name</li>
                            </ul>
                        }
                    }
                    else
                    {
                        <p class="text-center empty">No inspections scheduled for today.</p>
                    }
                }
                else
                {
                    <p class="text-center empty">No inspections scheduled for today.</p>
                }
            </div>
        </div>
    </div>
    </div>
</section>

<script>
    $(document).ready(function () {
    // Ottieni la data odierna in formato YYYY-MM-DD
    var now = new Date();
    var today = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');

    // Recupera i dati salvati nel localStorage
    var inspectionData = JSON.parse(localStorage.getItem('inspectionData') || '{}');
    var inspectionCoordinatesSentDate = inspectionData.date;
    var sentInspectionIds = inspectionData.sentInspectionIds || [];
    var attemptedInspectionIds = inspectionData.attemptedInspectionIds || [];
    var geocodingQueue = [];
    var activeRequests = 0;
    var maxConcurrentRequests = 2;

    function saveInspectionData() {
        inspectionData.date = today;
        inspectionData.sentInspectionIds = sentInspectionIds;
        inspectionData.attemptedInspectionIds = attemptedInspectionIds;
        localStorage.setItem('inspectionData', JSON.stringify(inspectionData));
    }

    function markAttempted(inspectionId) {
        if (!attemptedInspectionIds.includes(inspectionId)) {
            attemptedInspectionIds.push(inspectionId);
        }
        saveInspectionData();
    }

    function loadInspectionCoordinates() {
        // Controlla se le coordinate sono già state inviate oggi
        if (inspectionCoordinatesSentDate !== today) {
            // Se la data è diversa, resetta l'elenco degli ID inviati
            sentInspectionIds = [];
            attemptedInspectionIds = [];
            inspectionCoordinatesSentDate = today;
            saveInspectionData();
        }

        // Itera su ogni elemento con la classe 'inspection-item'
        $('.inspection-item').each(function () {
            var inspectionId = $(this).data('inspection-id');
            var fullAddress = $(this).data('fulladdress');
            var locationName = $(this).data('locationname');
            var space = " ";

            if (!fullAddress && !locationName)
                return;

            // Se l'ispezione è già stata inviata, salta
            if (sentInspectionIds.includes(inspectionId) || attemptedInspectionIds.includes(inspectionId))
                return;

            // Combina nome e indirizzo per la geocodifica
            geocodingQueue.push({
                inspectionId: inspectionId,
                fullAddress: fullAddress,
                locationName: locationName,
                addressToGeocode: locationName + space + fullAddress
            });
        });

        processGeocodingQueue();
    }

    function processGeocodingQueue() {
        while (activeRequests < maxConcurrentRequests && geocodingQueue.length) {
            geocodeInspection(geocodingQueue.shift());
        }
    }

    function geocodeInspection(item) {
        activeRequests++;

        // Marker synchronization is background work: it must never delay the page UI.
            $.ajax({
                url: '@Url.Action("GeocodeAddress", "Geocoding")',
                type: 'POST',
                data: { address: item.addressToGeocode },
                success: function (data) {
                    if (data.success) {
                        var lat = data.latitude;
                        var lon = data.longitude;

                        var coordinateData = {
                            Latitude: parseFloat(lat),
                            Longitude: parseFloat(lon),
                            Timestamp: new Date().toISOString(),
                            Address: item.fullAddress,
                            LocationName: item.locationName
                        };

                        var inspectorId = '@inspectorIdCookie';

                        // Invia i dati al server
                        $.ajax({
                            url: 'https://tracking.waman.app/api/coordinates/add?id=' + inspectorId,
                            method: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(coordinateData)
                        })
                        .done(function (response) {
                            if (!sentInspectionIds.includes(item.inspectionId)) {
                                sentInspectionIds.push(item.inspectionId);
                            }
                        })
                        .fail(function (err) {
                            console.warn("Inspection marker was not synchronized for " + item.fullAddress);
                        })
                        .always(function () {
                            markAttempted(item.inspectionId);
                            activeRequests--;
                            processGeocodingQueue();
                        });
                    } else {
                        markAttempted(item.inspectionId);
                        activeRequests--;
                        processGeocodingQueue();
                    }
                },
                error: function (jqxhr, textStatus, error) {
                    console.warn("Geocoding request failed for " + item.fullAddress);
                    markAttempted(item.inspectionId);
                    activeRequests--;
                    processGeocodingQueue();
                }
            });
    }

    // Run non-essential marker synchronization only after the page has settled.
    if ('requestIdleCallback' in window) {
        requestIdleCallback(loadInspectionCoordinates, { timeout: 2500 });
    } else {
        setTimeout(loadInspectionCoordinates, 1200);
    }
});
</script>
