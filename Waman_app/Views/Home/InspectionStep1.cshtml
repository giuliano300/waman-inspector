@using Waman_app.Models
@model CompleteInspectorPlanning
@{
    ViewBag.Title = "Inspection details";
}

<style>
    .span-sig{
        display: none;
    }

    .img-sig {
        display: block;
        max-height:95%;
        max-width:95%;
    }

    .img-none {
        display: none;
    }

    .span-show {
        display: block;
    }
</style>

<div class="inspection-heading page-hero page-hero--with-meta">
    <div>
        <span class="page-heading__eyebrow">Inspection details</span>
        <h1>@Model.location.name</h1>
        <p><i class="ph ph-map-pin ui-icon"></i> @Model.location.address</p>
    </div>
    <div class="inspection-heading__meta">
        <span><small>Date</small><strong>@Model.inspectorPlanning.date.ToString("dd MMM yyyy")</strong></span>
        <span><small>Time</small><strong>@Model.inspectorPlanning.time.ToString(@"hh\:mm")</strong></span>
        <span><small>Representative</small><strong>@Model.location.entityRapresentative</strong></span>
    </div>
</div>

<form method="post" action="/Home/SaveInspectionStep1" id="inspectionForm" class="inspection-workflow">
    <input type="hidden" name="inspectorPlanningId" value="@Model.inspectorPlanning.id" />
    <div class="inspection-form">
        <div class="row">
            <div class="col-md-12">
                <div class="section-heading">
                    <div><span>Step 1 of 2</span><h2>Workers on site</h2></div>
                    <p>Complete attendance details and collect signatures.</p>
                </div>
            </div>
            <div class="col-md-12">
                <div class="worker-list">
                    @if (Model.details != null && Model.details.Any())
                    {
                        foreach (var detail in Model.details)
                        {
                            <article class="worker-card">
                                <header class="worker-card__header">
                                    <span class="worker-card__avatar"><i class="ph ph-user-circle ui-icon"></i></span>
                                    <div class="worker-card__identity">
                                        <h3>@detail.worker.name @detail.worker.lastName</h3>
                                        <div class="worker-card__meta">
                                            <span><i class="ph ph-phone ui-icon"></i> @detail.worker.mobile</span>
                                            <span><i class="ph ph-identification-card ui-icon"></i> @detail.worker.idCardNumber</span>
                                        </div>
                                    </div>
                                    <button type="button" class="worker-signature" onclick="OpenPopupSignature('.signature-popup',@detail.det.id)">
                                    @if (@detail.det.signature == null)
                                    {
                                        <img class="img-sig-@detail.det.id img-sig img-none" src="" />
                                            <span class="span-show span-sig span-sig-@detail.det.id"><i class="ph ph-signature ui-icon"></i><em>Add signature</em></span>
                                    }
                                    else
                                    {
                                        <img class="img-sig-@detail.det.id img-sig" src="@detail.det.signature" />
                                    }
                                    <input type="hidden" name="himg_sig_@detail.det.id" class="himg-sig-@detail.det.id" />
                                    </button>
                                </header>
                                <div class="worker-card__body">
                                    <fieldset class="decision-field">
                                        <legend>Timesheet available?</legend>
                                        <div class="segmented-control">
                                            <label><input type="radio" name="timeSheet_@detail.det.id" value="true" required @(detail.det.timeSheet == true ? "checked" : "") /><span>Yes</span></label>
                                            <label><input type="radio" name="timeSheet_@detail.det.id" value="false" required @(detail.det.timeSheet == false ? "checked" : "") /><span>No</span></label>
                                        </div>
                                    </fieldset>
                                    <fieldset class="decision-field">
                                        <legend>Worker found on site?</legend>
                                        <div class="segmented-control">
                                            <label><input type="radio" name="foundAtWork_@detail.det.id" value="true" required @(detail.det.foundAtWork == true ? "checked" : "") /><span>Yes</span></label>
                                            <label><input type="radio" name="foundAtWork_@detail.det.id" value="false" required @(detail.det.foundAtWork == false ? "checked" : "") /><span>No</span></label>
                                        </div>
                                    </fieldset>
                                    <div class="worker-card__issues">
                                        <label for="issues_@detail.det.id">Other issues <small>Optional</small></label>
                                        <textarea id="issues_@detail.det.id" name="otherIssues_@detail.det.id" placeholder="Add a note...">@detail.det.otherIssues</textarea>
                                    </div>
                                </div>
                            </article>
                        }
                    }
                    else
                    {
                        <div class="empty-state"><i class="ph ph-user-minus ui-icon"></i><p>No workers assigned to this location.</p></div>
                    }
                </div>
            </div>
        </div>
        <div class="row mt-20">
            <div class="col-md-12">
                <div class="form-card">
                    <label for="inspectorComments">Inspector comments <small>Optional</small></label>
                    <textarea id="inspectorComments" class="entity-comments" placeholder="Add notes about this inspection..." name="comments">@Model.inspectorPlanning.comments</textarea>
                </div>
            </div>
        </div>
    </div>
    <div class="inspection-action-dock" role="group" aria-label="Inspection actions">
        <div class="inspection-actions">
            <a href="/Home/InspectionPlan" class="back-button"><i class="ph ph-caret-left ui-icon"></i>Back</a>
            <span class="inspection-action-dock__status"><small>Step 1 of 2</small><strong>Workers and attendance</strong></span>
            <button type="submit" class="next-button">Continue to declaration <i class="ph ph-caret-right ui-icon"></i></button>
        </div>
    </div>
</form>

<!-- popup della firma -->
<div class="container-popup signature-popup" role="dialog" aria-modal="true" aria-labelledby="signature-dialog-title">
    <section class="signature-dialog">
        <header class="signature-dialog__header">
            <span class="signature-dialog__icon"><i class="ph ph-signature ui-icon"></i></span>
            <div class="signature-dialog__copy">
                <span class="signature-dialog__eyebrow">Worker confirmation</span>
                <h2 id="signature-dialog-title">Add signature</h2>
                <p>Sign naturally with a finger or stylus inside the area below.</p>
            </div>
            <button type="button" class="close-popup" aria-label="Close signature" onclick="ClosePopup('.signature-popup')"><span class="signature-dialog__close-glyph" aria-hidden="true">&times;</span></button>
        </header>
        <div class="signature-dialog__body">
            <div class="signature-dialog__canvas-heading">
                <strong>Signature area</strong>
                <span>Keep the signature above the line</span>
            </div>
            <div class="signature-dialog__canvas-wrap">
                <canvas id="sig-canvas-1">
                    Your browser does not support the canvas element.
                </canvas>
                <span class="signature-dialog__line" aria-hidden="true"></span>
            </div>
        </div>
        <footer class="signature-dialog__actions">
            <button type="button" class="btn-sign signature-dialog__clear" id="sig-clearBtn"><i class="ph ph-eraser ui-icon"></i>Clear</button>
            <button type="button" class="btn-sign signature-dialog__confirm" id="sig-submitBtn"><i class="ph ph-check-circle ui-icon"></i>Confirm signature</button>
        </footer>
    </section>
    <input type="hidden" name="id" class="sig-id" />
</div>


<script>

    (function () {

        const canvas = document.getElementById("sig-canvas-1");
        let ctx = null;

        if (canvas != null) {
            ctx = canvas.getContext("2d");
            ctx.strokeStyle = "#222222";
            ctx.lineWidth = 1;
            const sigSubmitBtn = document.getElementById("sig-submitBtn");
            const sigClearBtn = document.getElementById("sig-clearBtn");

            let drawing = false;
            let lastPos = { x: 0, y: 0 };
            canvas.dataset.hasInk = "false";

            // Funzione per ottenere le coordinate del mouse o del tocco
            function getPosition(event) {
                const rect = canvas.getBoundingClientRect();
                const scaleX = canvas.width / rect.width;
                const scaleY = canvas.height / rect.height;
                if (event.touches) {
                    return {
                        x: (event.touches[0].clientX - rect.left) * scaleX,
                        y: (event.touches[0].clientY - rect.top) * scaleY
                    };
                }
                return {
                    x: (event.clientX - rect.left) * scaleX,
                    y: (event.clientY - rect.top) * scaleY
                };
            }

            // Funzione per iniziare a disegnare
            function startDrawing(event) {
                drawing = true;
                lastPos = getPosition(event);
            }

            // Funzione per fermare il disegno
            function stopDrawing() {
                drawing = false;
            }

            // Funzione per disegnare
            function draw(event) {
                if (!drawing) return;
                const pos = getPosition(event);
                ctx.beginPath();
                ctx.moveTo(lastPos.x, lastPos.y);
                ctx.lineTo(pos.x, pos.y);
                ctx.stroke();
                ctx.closePath();
                lastPos = pos;
                canvas.dataset.hasInk = "true";
            }

            // Eventi per mouse
            canvas.addEventListener("mousedown", startDrawing);
            canvas.addEventListener("mousemove", draw);
            canvas.addEventListener("mouseup", stopDrawing);
            canvas.addEventListener("mouseleave", stopDrawing);

            // Eventi per touch
            canvas.addEventListener("touchstart", (e) => {
                e.preventDefault();
                startDrawing(e);
            });
            canvas.addEventListener("touchmove", (e) => {
                e.preventDefault();
                draw(e);
            });
            canvas.addEventListener("touchend", (e) => {
                e.preventDefault();
                stopDrawing();
            });

            // Pulsante per cancellare la firma
            sigClearBtn.addEventListener("click", function () {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                canvas.dataset.hasInk = "false";
            });

            // Pulsante per confermare la firma
            sigSubmitBtn.addEventListener("click", function () {

                let id = $('.sig-id').val();
                if (!id)
                    return;

                if (canvas.dataset.hasInk !== "true") {
                    ShowMessage("Signature required", "Please sign in the box before confirming.");
                    return;
                }

                const sigImage = $(".img-sig-" + id);
                const hsigImage = $(".himg-sig-" + id);
                const spanSignature = $(".span-sig-" + id);


                const dataUrl = canvas.toDataURL("image/png");
                sigImage.attr('src', dataUrl);
                hsigImage.val(dataUrl);

                sigImage.removeClass('img-none');

                spanSignature.removeClass('span-show');
                ClosePopup(".signature-popup");

                $('.sig-id').val('');
            });
        }
    })();

    // Funzione per chiudere un popup specifico
    function ClosePopup(selector) {
        const popup = document.querySelector(selector);
        if (!popup) return;

        popup.style.opacity = '1';
        popup.style.transition = 'opacity 0.3s ease';

        // Avviamo l'animazione di fade-out
        requestAnimationFrame(() => {
            popup.style.opacity = '0';
            setTimeout(() => {
                // Dopo la transizione nascondiamo l'elemento
                popup.style.visibility = 'hidden';
                popup.style.display = 'none';
            }, 300);
        });

        // Ripristina lo scroll sul body
        document.body.classList.remove('no-scroll');
    }


    // Funzione per aprire un popup specifico
    function OpenPopupSignature(selector, id) {
        const canvas = document.getElementById("sig-canvas-1");
        let ctx = canvas.getContext("2d");

        const popup = document.querySelector(selector);
        if (!popup) return;

        $('.sig-id').val(id);

        // All'inizio impostiamo lo stile a display: block e opacity 0
        popup.style.display = 'flex';
        popup.style.visibility = 'visible';
        popup.style.opacity = '0';
        popup.style.transition = 'opacity 0.3s ease';

        popup.offsetHeight;

        const rect = canvas.getBoundingClientRect();
        const ratio = Math.max(window.devicePixelRatio || 1, 1);
        canvas.width = Math.round(rect.width * ratio);
        canvas.height = Math.round(rect.height * ratio);
        ctx.strokeStyle = "#172033";
        ctx.lineWidth = 2.25 * ratio;
        ctx.lineCap = "round";
        ctx.lineJoin = "round";
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        canvas.dataset.hasInk = "false";

        // Forziamo l'animazione con requestAnimationFrame
        requestAnimationFrame(() => {
            popup.style.opacity = '1'; // Fai il fade-in
        });

        // Previene lo scroll del body
        document.body.classList.add('no-scroll');
    }

</script>
