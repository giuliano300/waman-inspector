@using Waman_app.Models
@model CompleteInspectorPlanning

@{
    ViewBag.Title = "InspectionEnd";

    var openInspections = 0;
    if (Request.Cookies["OpenPlanningsCount"] != null)
    {
        openInspections = int.Parse(Request.Cookies["OpenPlanningsCount"].Value);
    }
}

<form method="post" action="/Home/SaveInspectionEnd" id="inspectionEndForm">
    <input type="hidden" name="inspectorPlanningId" value="@Model.inspectorPlanning.id" />
    <input type="hidden" name="inspectorId" value="@Model.inspector.id" />

    <div class="row">
        <div class="col-md-12">
            <h1 class="mt-30">@Model.location.name</h1>
        </div>
        <div class="col-md-6">
            <h4 class="mt-15 mb-10 color-azure">ENTITY REPRESENTATIVE</h4>
            <div class="textsize-5 background-grey p-20">
                <p>
                    <strong>Name & Surname:</strong>&nbsp;<span>@Model.location.entityRapresentative</span><br />
                    <strong>Job Title:</strong>&nbsp;<span>@Model.location.jobTitle</span><br />
                    <strong>Date:</strong>&nbsp;<span>@Model.inspectorPlanning.date.ToString("dd/MM/yyyy")</span><br />
                    <strong>Time:</strong>&nbsp;<span>@Model.inspectorPlanning.time.ToString(@"hh\:mm")</span>
                </p>
            </div>
        </div>
        <div class="col-md-6">
            <h4 class="mt-15 mb-10 color-azure">WORKERS LIST</h4>
            <div class="textsize-5 background-grey p-20">
                @if (Model.details != null && Model.details.Any())
                {
                    foreach (var detail in Model.details)
                    {
                        <p>
                            <strong>@detail.worker.name @detail.worker.lastName</strong>&nbsp;
                            <em>(@detail.jobTypeName)</em><br />
                        </p>
                    }
                }
                else
                {
                    <p>No workers assigned to this location.</p>
                }
            </div>
        </div>
    </div>

    <div class="page-list mt-30">
        <div class="row">
            <div class="col-md-12">
                <div class="flex-column">
                    <h4 class="color-blue mb-10">ENTITY COMMENTS:</h4>
                    <textarea class="entity-comments" placeholder="Write a note or comment here..." name="entityComment">@Model.inspectorPlanning.entityComment</textarea>
                </div>
            </div>
            <div class="col-md-12 mt-20">
                <div class="site-table site-table-inspection site-table-form">
                    <ul>
                        <li style="width:80%;">
                            <strong>
                                We confirm that the inspection was carried out as reported<br />
                                by the CWSEF Inspector to the satisfaction of our entity.
                            </strong>
                        </li>
                        <li style="width:20%; justify-content: center;">
                            <div class="flex-between">
                                <section class="text-center mr-15">
                                    <label for="confirm_yes">
                                        YES<br />
                                        <input type="radio" id="confirm_yes" name="inspectionConfirmation" value="true" required checked />
                                    </label>
                                </section>
                                <section class="text-center ml-15">
                                    <label for="confirm_no">
                                        NO<br />
                                        <input type="radio" id="confirm_no" name="inspectionConfirmation" value="false" required />
                                    </label>
                                </section>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-md-12 mt-20">
                <div class="site-table site-table-inspection site-table-form">
                    <ul>
                        <li style="width:80%;">
                            <strong>
                                Select YES if the facility representative is present and have them sign in the following box,<br />otherwise select NO and add a reason.
                            </strong>
                        </li>
                        <li style="width:20%; justify-content: center;">
                            <div class="flex-between">
                                <section class="text-center mr-15">
                                    <label for="confirm_yes">
                                        YES<br />
                                        <input type="radio" id="existEntityRappresentative_yes" class="existEntityRappresentative" name="existEntityRappresentative" value="true" required checked />
                                    </label>
                                </section>
                                <section class="text-center ml-15">
                                    <label for="confirm_no">
                                        NO<br />
                                        <input type="radio" id="existEntityRappresentative_no" class="existEntityRappresentative" name="existEntityRappresentative" value="false" required />
                                    </label>
                                </section>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="col-md-12 mt-20">
                <div class="site-table site-table-inspection site-table-form">
                    <ul>
                        <li style="width:80%;">
                            <strong>
                                Selecting YES you send the report to the administration which will evaluate any differences
                            </strong>
                        </li>
                        <li style="width:20%; justify-content: center;">
                            <div class="flex-between">
                                <section class="text-center mr-15">
                                    <label for="confirm_yes">
                                        YES<br />
                                        <input type="radio" id="sendReportToAdministration_yes" class="sendReportToAdministration" name="sendReportToAdministration" value="true" required  />
                                    </label>
                                </section>
                                <section class="text-center ml-15">
                                    <label for="confirm_no">
                                        NO<br />
                                        <input type="radio" id="sendReportToAdministration_no" class="sendReportToAdministration" name="sendReportToAdministration" value="false" required checked />
                                    </label>
                                </section>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="col-md-12 mt-20 div-absent-comments">
                <div class="flex-column">
                    <h4 class="color-blue mb-10">WHY THE REPRESENTATIVE IS ABSENT:</h4>
                    <textarea class="absent-comments" placeholder="Write a comment here..." name="inspectorAbsenceComment"></textarea>
                </div>
            </div>

        </div>
    </div>
    <div class="row row-signature">
        <div class="col-md-12">
            <div class="flex-end mt-10">
                <div class="flex-column">
                    <h4 class="color-blue mb-5">SIGNATURE:</h4>
                    <div class="container-box" onclick="OpenPopup('.signature-popup')">
                        <div id="box-signature"></div>
                        <img id="sig-image" src="" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-15">
        <div class="col-md-12">
            <div class="line-top"></div>
        </div>
        <div class="col-md-12">
            <div class="flex-between">
                <a href="/Home/InspectionStep1?id=@Model.inspectorPlanning.id" class="back-button"><i class='bx bx-chevron-left'></i>BACK</a>
                <button id="submitInspectionEnd" type="button" class="next-button">CLOSE INSPECTION <i class='bx bx-check'></i></button>
            </div>
        </div>
    </div>
</form>

<!-- popup della firma -->
<div class="container-popup signature-popup">
    <section>
        <a class="close-popup" onclick="ClosePopup('.signature-popup')"><i class='bx bx-x'></i></a>
        <div class="flex-column">
            <h5 class="color-blue mb-10">Sign here and confirm</h5>
            <canvas id="sig-canvas">
                Your browser does not support the canvas element.
            </canvas>
            <div class="mt-10">
                <button class="btn-sign background-green mr-10" id="sig-submitBtn"><i class='bx bx-check'></i>&nbsp;Confirm Signature</button>
                <button class="btn-sign background-red" id="sig-clearBtn"><i class='bx bx-reset'></i>&nbsp;Clear Signature</button>
            </div>
        </div>
    </section>
</div>

<script>
    $('.existEntityRappresentative').on('change', function () {
        $('.div-absent-comments').hide();
        $('.row-signature').show();
        if ($(this).val() == "false") {
            $('.div-absent-comments').show();
            $('.row-signature').hide();
            $('.absent-comments').attr('required', 'required');
        }
    })
</script>


