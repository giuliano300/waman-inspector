@using Waman_app.Models;
@using System.Globalization;
@model List<CompleteInspectorPlanning>

<div class="page-heading page-hero">
    <div>
        <span class="page-heading__eyebrow">Completed work</span>
        <h1>Inspection archive</h1>
        <p>Search past inspections and open their details or report.</p>
    </div>
</div>

<div class="page-list archive-page">
    <div class="row">
        <div class="col-md-12">
            <div class="page-list__header">
                @using (Html.BeginForm("InspectionArchive", "Home", FormMethod.Get, new { id = "filter" }))
                {
                    <div class="archive-filters">
                        <h4 class="color-blue">Filter by</h4>

                        <div class="mr-10">
                            <strong>Location</strong><br />
                            <input type="text" name="locationName" placeholder="Location name" value="@Request.QueryString["locationName"]" />
                        </div>
                        <div class="mr-10">
                            <strong>Month</strong><br />
                            <select name="month">
                                @*<option selected value="">Select month</option>*@
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i" @if(i == ViewBag.month) {<text> selected </text>}>@CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(i)</option>
                                }
                            </select>
                        </div>
                        <div class="mr-10">
                            <strong>Year</strong><br />
                            <select name="year">
                                @*<option selected value="">Select year</option>*@
                                @for (int year = DateTime.Now.Year; year >= DateTime.Now.Year - 3; year--)
                                {
                                    <option value="@year" @if(year == ViewBag.year) {<text> selected </text>}>@year</option>
                                }
                            </select>
                        </div>
                        <div class="archive-filter-actions">
                            <input type="submit" value="" aria-label="Apply filters" title="Apply filters" />
                            <button id="resetFilter" type="button" class="delete-filter" title="Reset filters"><i class="ph ph-arrow-counter-clockwise ui-icon"></i><span>Reset</span></button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="site-table archive-table">
                <ul class="site-table__top">
                    <li style="width:15%;"><span>DATE</span></li>
                    <li style="width:55%;"><span>LOCATION</span></li>
                    <li style="width:10%; justify-content: center;"><span>STATUS</span></li>
                    <li style="width:10%; justify-content: center;"><span>DETAILS</span></li>
                    <li style="width:10%; justify-content: center;"><span>REPORT</span></li>
                </ul>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model.OrderByDescending(a => a.inspectorPlanning.date))
                    {
                        <ul>
                            <li style="width:15%;">@item.inspectorPlanning.date.ToString("dd/MM/yyyy")</li>
                            <li style="width:55%;">@item.location.name</li>
                            <li style="width:10%; justify-content: center;">
                                <i class="ph ph-check ui-icon archive-status-icon" role="img" aria-label="Completed" title="Completed"></i>
                            </li>
                            <li style="width:10%; justify-content: center;">
                                <a class="archive-icon-action" href="/Home/InspectionReport/@item.inspectorPlanning.id" aria-label="View inspection details" title="View details"><i class="ph ph-magnifying-glass ui-icon" aria-hidden="true"></i></a>
                            </li>
                            <li style="width:10%; justify-content: center;">
                                @if (!string.IsNullOrWhiteSpace(item.inspectorPlanning.reportFilePath))
                                {

                                    var expire = DateTime.UtcNow.AddMinutes(10).Ticks;

                                    var id = item.inspectorPlanning.id;

                                    var h = Waman_app.Models.BaseClass.ComputeHmac(id + "|" + expire, Waman_app.Models.BaseClass.secret);

                                    var url = Waman_app.Models.BaseClass.apiUri + "/Files/Rept/"
                                        + id
                                        + "?e=" + expire
                                        + "&h=" + h;

                                    <a class="archive-icon-action archive-icon-action--report" href="@url" target="_blank" aria-label="Open PDF report" title="Open PDF report">
                                        <i class="ph ph-download-simple ui-icon" aria-hidden="true"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="archive-icon-action is-disabled" aria-label="Report not available" title="Report not available"><i class="ph ph-minus ui-icon" aria-hidden="true"></i></span>
                                }
                            </li>
                        </ul>

                    }

                }
                else
                {
                    <p class="text-center mt-10 mb-10">No inspections found for the selected filters.</p>
                }
            </div>
            @Html.Partial("PaginationInspectionArchive")
        </div>
    </div>
</div>

<script>
    // Reset filter functionality
    document.getElementById("resetFilter").addEventListener("click", function () {
        const form = document.getElementById("filter");
        form.reset();
        window.location.href = '@Url.Action("InspectionArchive", "Home")';
    });
</script>
