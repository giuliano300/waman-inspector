
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>WAMAN - Login</title>

    <!--favicon-->
    <link rel="apple-touch-icon" sizes="57x57" href="/Images/Favicon/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/Images/Favicon/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/Images/Favicon/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/Images/Favicon/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/Images/Favicon/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/Images/Favicon/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/Images/Favicon/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/Images/Favicon/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/Images/Favicon/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/Images/Favicon/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/Images/Favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/Images/Favicon/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/Images/Favicon/favicon-16x16.png">
    <link rel="manifest" href="/Images/Favicon/manifest.json">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="/Images/Favicon/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
    <!--end favicon-->

    <link rel="preload" href="/Content/phosphor/Phosphor.woff2" as="font" type="font/woff2" crossorigin />
    <link href="/Content/phosphor/style.css?ver=2.1.2" rel="stylesheet" />
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/style.css" rel="stylesheet" />
    <link href="~/Content/inspector-v3.css?ver=7.4" rel="stylesheet" />


</head>
<body class="auth-page">
    <aside class="auth-brand">
        <a href="/" class="auth-brand__logo"><img src="~/Images/Logo.png" alt="Waman" width="190" height="72" /></a>
        <div class="auth-brand__copy">
            <span>Inspector workspace</span>
            <h1>Every inspection.<br />Clearly handled.</h1>
            <p>Your daily schedule, inspection records and field reports in one focused workspace.</p>
        </div>
        <div class="auth-brand__footer">&copy; @DateTime.Now.Year District Operations Ltd</div>
    </aside>

    <main class="auth-panel">
        <section class="auth-card">
            <a href="/" class="auth-mobile-logo"><img src="~/Images/Logo.png" alt="Waman" width="150" height="57" /></a>
            <span class="auth-card__eyebrow">Secure access</span>
            <h2>Welcome back</h2>
            <p class="auth-card__intro">Sign in with your inspector credentials to continue.</p>

            @using (Html.BeginForm("Logon", "Home", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="auth-field">
                    <label for="email">Email address</label>
                    <div class="auth-field__control">
                        <i class="ph ph-envelope-simple ui-icon"></i>
                        <input id="email" type="email" placeholder="name@example.com" name="email" autocomplete="username" required />
                    </div>
                </div>
                <div class="auth-field">
                    <label for="pwd">Password</label>
                    <div class="auth-field__control">
                        <i class="ph ph-lock-key ui-icon"></i>
                        <input id="pwd" type="password" placeholder="Enter your password" name="pwd" autocomplete="current-password" required />
                    </div>
                </div>
                <div class="auth-meta"><a href="/Home/RestorePwd">Forgot password?</a></div>
                <button type="submit" class="auth-submit">Sign in <i class="ph ph-arrow-right ui-icon"></i></button>
                if (TempData["errormessage"] != null)
                {
                    <div class="auth-error" role="alert">@TempData["errormessage"]</div>
                }
            }
        </section>
    </main>

    @Html.Partial("_AppFooter")

</body>
</html>
