@using Waman_app.Models
@model CompleteInspectorPlanning
@{
    ViewBag.Title = "Inspection Report";
}

<div class="inspection-heading report-heading page-hero page-hero--with-meta">
    <div>
        <span class="page-heading__eyebrow">Completed inspection</span>
        <h1>@Model.location.name</h1>
        <p><i class="ph ph-map-pin ui-icon"></i> @Model.location.address</p>
    </div>
    <div class="inspection-heading__meta">
        <span><small>Date</small><strong>@Model.inspectorPlanning.date.ToString("dd MMM yyyy")</strong></span>
        <span><small>Time</small><strong>@Model.inspectorPlanning.time.ToString(@"hh\:mm")</strong></span>
        <span><small>Representative</small><strong>@Model.location.entityRapresentative</strong></span>
    </div>
</div>

<div class="section-heading">
    <div><span>Inspection record</span><h2>Workers inspected</h2></div>
    <p>Read-only report</p>
</div>

<div class="worker-list report-worker-list">
    @if (Model.details != null && Model.details.Any())
    {
        foreach (var detail in Model.details)
        {
            <article class="worker-card worker-card--report">
                <header class="worker-card__header">
                    <span class="worker-card__avatar"><i class="ph ph-user-circle ui-icon"></i></span>
                    <div class="worker-card__identity">
                        <h3>@detail.worker.name @detail.worker.lastName</h3>
                        <div class="worker-card__meta">
                            <span><i class="ph ph-phone ui-icon"></i> @detail.worker.mobile</span>
                            <span><i class="ph ph-identification-card ui-icon"></i> @detail.worker.idCardNumber</span>
                        </div>
                    </div>
                    <div class="report-signature">
                        @if (detail.det.signature == null)
                        {
                            <span>No signature</span>
                        }
                        else
                        {
                            <img src="@detail.det.signature" alt="Worker signature" />
                        }
                    </div>
                </header>
                <div class="report-facts">
                    <div><small>Timesheet</small><strong class="@(detail.det.timeSheet == true ? "is-positive" : "is-negative")"><i class="ph @(detail.det.timeSheet == true ? "ph-check" : "ph-x") ui-icon"></i> @(detail.det.timeSheet == true ? "Yes" : "No")</strong></div>
                    <div><small>Found at work</small><strong class="@(detail.det.foundAtWork == true ? "is-positive" : "is-negative")"><i class="ph @(detail.det.foundAtWork == true ? "ph-check" : "ph-x") ui-icon"></i> @(detail.det.foundAtWork == true ? "Yes" : "No")</strong></div>
                    <div class="report-facts__notes"><small>Other issues</small><p>@(string.IsNullOrWhiteSpace(detail.det.otherIssues) ? "None reported" : detail.det.otherIssues)</p></div>
                </div>
            </article>
        }
    }
    else
    {
        <div class="empty-state"><i class="ph ph-user-minus ui-icon"></i><p>No workers assigned to this location.</p></div>
    }
</div>

<div class="report-notes-grid">
    <section class="form-card"><label>Inspector comments</label><p>@(string.IsNullOrWhiteSpace(Model.inspectorPlanning.comments) ? "No comments" : Model.inspectorPlanning.comments)</p></section>
    <section class="form-card"><label>Entity comments</label><p>@(string.IsNullOrWhiteSpace(Model.inspectorPlanning.entityComment) ? "No comments" : Model.inspectorPlanning.entityComment)</p></section>
    @if (!string.IsNullOrWhiteSpace(Model.inspectorPlanning.inspectorAbsenceComment))
    {
        <section class="form-card"><label>Representative absence</label><p>@Model.inspectorPlanning.inspectorAbsenceComment</p></section>
    }
    <section class="form-card report-entity-signature">
        <label>Representative signature</label>
        @if (!string.IsNullOrWhiteSpace(Model.inspectorPlanning.signature))
        {
            <img src="https://auth.waman.app/@Model.inspectorPlanning.signature" alt="Representative signature" />
        }
        else
        {
            <p>No signature</p>
        }
    </section>
</div>

<div class="inspection-actions">
    <a href="/Home/InspectionArchive" class="back-button"><i class="ph ph-caret-left ui-icon"></i> Back to archive</a>
</div>
