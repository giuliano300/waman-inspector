@using Waman_app.Models;
@model List<Waman_app.Models.CompleteInspectorPlanning>
@using System.Globalization

<div class="page-heading page-hero">
    <div>
        <span class="page-heading__eyebrow">@DateTime.Now.ToString("dddd, dd MMMM yyyy", CultureInfo.InvariantCulture)</span>
        <h1>Daily inspection plan</h1>
        <p>Open the route or start the inspection when you arrive.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="planning">
            @if (Model != null && Model.Any())
            {
                var today = DateTime.Today;
                var dailyPlans = Model.Where(item => item.inspectorPlanning.date.Date == today).OrderBy(a => a.inspectorPlanning.time).ToList();

                if (dailyPlans.Any())
                {
                    foreach (var item in dailyPlans)
                    {
                        <div class="planning__item">
                            <div class="planning__item-info">
                                <section class="planning__meta">
                                    <span class="mr-30">
                                        <i class="ph ph-calendar-check ui-icon color-primary"></i> @item.inspectorPlanning.date.ToString("dd/MM/yyyy")
                                    </span>
                                    <span>
                                        <i class="ph ph-clock ui-icon color-primary"></i> @item.inspectorPlanning.time.ToString(@"hh\:mm")
                                    </span>
                                </section>
                                <h2>
                                    @item.location.name
                                </h2>
                                <p>@item.location.address - @item.city.name</p>
                            </div>
                            <div class="planning__item-action">
                                @if (!item.inspectorPlanning.closed)
                                {
                                    <a href="@GenerateNavigationUrl(item.location, item.city)" target="_blank" class="planning-action planning-action--navigate">
                                        <i class="ph ph-navigation-arrow ui-icon"></i>
                                        <span>
                                            Navigate to<br />
                                            Location
                                        </span>
                                    </a>
                                    <a href="@Url.Action("InspectionStep1", "Home", new { id = item.inspectorPlanning.id })" class="planning-action planning-action--start">
                                        <i class="ph ph-play-circle ui-icon"></i>
                                        <span>
                                            Start<br />
                                            Inspection
                                        </span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-center mb-10 mt-10">No inspections scheduled for today.</p>
                }
            }
            else
            {
                <div class="empty-state"><i class="ph ph-calendar-x ui-icon"></i><p>No inspections scheduled for today.</p></div>
            }
        </div>
    </div>
</div>


@functions {
    // Helper function to generate navigation URL including city
    public string GenerateNavigationUrl(Locations location, Cities city)
    {
        if (location != null && !string.IsNullOrEmpty(location.address) && city != null && !string.IsNullOrEmpty(city.name))
        {
            var fullAddress = $"{location.name} {location.address}, {city.name}";
            var encodedAddress = Uri.EscapeDataString(fullAddress);
            return $"https://www.google.com/maps/search/?api=1&query={encodedAddress}";
        }
        return "#";
    }
}
