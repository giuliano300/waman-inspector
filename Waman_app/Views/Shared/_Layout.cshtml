@using Waman_app.Models;
@using Newtonsoft.Json;

<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Waman - @ViewBag.Title</title>

    <!--favicon-->
    <link rel="apple-touch-icon" sizes="57x57" href="/Images/Favicon/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/Images/Favicon/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/Images/Favicon/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/Images/Favicon/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/Images/Favicon/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/Images/Favicon/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/Images/Favicon/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/Images/Favicon/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/Images/Favicon/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/Images/Favicon/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/Images/Favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/Images/Favicon/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/Images/Favicon/favicon-16x16.png">
    <link rel="manifest" href="/Images/Favicon/manifest.json">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="/Images/Favicon/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
    <!--end favicon-->


    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/jquery")

    @if (Request.Cookies["ConnessoWamanInspectors"] == null)
    {
        Response.Redirect("/");
    }

    @{
        var u = new Inspectors();
        if (Request.Cookies["Inspectors"] != null)
        {
            u = JsonConvert.DeserializeObject<Inspectors>(Request.Cookies["Inspectors"].Value);
        }
        else
        {
            Response.Redirect("/");
        }
        bool inspectionIsStarted = false;
        if (Request.Cookies["Startinspection"] != null)
        {
            inspectionIsStarted = Convert.ToBoolean(Request.Cookies["Startinspection"].Value);
        }
        var currentAction = (ViewContext.RouteData.Values["action"] ?? "").ToString();
        int openPlanningsCount;
        var hasTodayInspections = ViewBag.HasTodayInspections is bool
            ? (bool)ViewBag.HasTodayInspections
            : int.TryParse(Request.Cookies["OpenPlanningsCount"]?.Value, out openPlanningsCount) && openPlanningsCount > 0;
    }

    <link rel="preload" href="/Content/phosphor/Phosphor.woff2" as="font" type="font/woff2" crossorigin />
    <link href="/Content/phosphor/style.css?ver=2.1.2" rel="stylesheet" />
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/style.css?ver=2.0" rel="stylesheet" />
    <link href="~/Content/inspector-v3.css?ver=7.4" rel="stylesheet" />
</head>
<body class="inspector-app">
    <div class="app-shell">
        <aside class="app-sidebar">
            <a href="/Home/Dashboard" class="app-brand" aria-label="Waman dashboard">
                <img src="~/Images/Logo.png" alt="Waman" width="142" height="54" />
            </a>

            <nav class="app-nav" id="main-navigation" aria-label="Main navigation">
                <a href="/Home/Dashboard" class="app-nav__item @(currentAction == "Dashboard" ? "is-active" : "")">
                    <i class="ph ph-squares-four ui-icon"></i><span>Overview</span>
                </a>
                @if (hasTodayInspections)
                {
                    <a href="/Home/InspectionPlan" class="app-nav__item @(currentAction == "InspectionPlan" || currentAction == "InspectionStep1" || currentAction == "InspectionEnd" ? "is-active" : "")">
                        <i class="ph ph-calendar-check ui-icon"></i><span>Daily plan</span>
                    </a>
                }
                else
                {
                    <span class="app-nav__item is-disabled" aria-disabled="true" title="No inspections scheduled today">
                        <i class="ph ph-calendar-x ui-icon"></i><span>Daily plan</span>
                    </span>
                }
                <a href="/Home/InspectionArchive" class="app-nav__item @(currentAction == "InspectionArchive" || currentAction == "InspectionReport" ? "is-active" : "")">
                    <i class="ph ph-archive ui-icon"></i><span>Archive</span>
                </a>
                <a href="/Home/InfoBox" class="app-nav__item @(currentAction == "InfoBox" ? "is-active" : "")">
                    <i class="ph ph-chat-teardrop-text ui-icon"></i><span>Info box</span>
                </a>
            </nav>

            <div class="app-user">
                <div class="app-user__avatar"><i class="ph ph-user-circle ui-icon"></i></div>
                <div class="app-user__copy"><small>Inspector</small><strong>@u.name @u.lastName</strong></div>
                <a href="/" class="app-user__logout" aria-label="Logout" title="Logout"><i class="ph ph-sign-out ui-icon"></i></a>
            </div>
        </aside>

        <section class="app-workspace">
            <header class="app-topbar">
                <a href="/Home/Dashboard" class="app-topbar__brand"><img src="~/Images/Logo.png" alt="Waman" width="112" height="43" /></a>
                <span>@u.name @u.lastName</span>
                <a href="/" aria-label="Logout"><i class="ph ph-sign-out ui-icon"></i></a>
            </header>

    <!-- Popup per START tracking -->
    <div class="container-popup gps-popup-start">
        <section>
            <div class="row">
                <div class="col-md-12">
                    <div class="popup-track">
                        <h2>Start GPS tracking</h2>
                        <p>Click on the "Start" button to start GPS tracking. Be sure to activate the tablet position first.</p>
                        <button onclick="ClosePopupAndStartTracking('@ViewBag.inspectorId')">
                            <i class="ph ph-play-circle ui-icon"></i>START
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Popup per RESTART tracking -->
    <div class="container-popup gps-popup-blocked">
        <section>
            <div class="row">
                <div class="col-md-12">
                    <div class="popup-track">
                        <h2>GPS tracking blocked</h2>
                        <p>Your tracking has been blocked or the tablet position isn't active. Activate it then click on "Restart" to continue tracking.</p>
                        <button onclick="ClosePopupAndRestartTracking('@ViewBag.inspectorId')">
                            <i class="ph ph-arrow-counter-clockwise ui-icon"></i>RESTART
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Main Content -->
            <main class="container-fluid main app-main">
                @RenderBody()
            </main>
        </section>
    </div>

    @Scripts.Render("~/bundles/site")

    @RenderSection("scripts", required: false)

    <script src="~/Scripts/bootstrap.bundle.min.js"></script>

    <!-- Modal -->
    <div class="modal fade" id="modal" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"></h5>
                    <button type="button" class="btn-close" data-mdb-ripple-init data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="modalBody"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-mdb-ripple-init data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    @Html.Partial("_AppFooter")

</body>
</html>
