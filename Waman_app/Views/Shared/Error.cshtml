@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WAMAN - Something went wrong</title>
    <link rel="preload" href="/Content/phosphor/Phosphor.woff2" as="font" type="font/woff2" crossorigin />
    <link href="/Content/phosphor/style.css?ver=2.1.2" rel="stylesheet" />
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/style.css" rel="stylesheet" />
    <link href="~/Content/inspector-v3.css?ver=7.4" rel="stylesheet" />
</head>
<body class="auth-page">
    <aside class="auth-brand">
        <a href="/" class="auth-brand__logo"><img src="~/Images/Logo.png" alt="Waman" width="190" height="72" /></a>
        <div class="auth-brand__copy"><span>Inspector workspace</span><h1>We hit an unexpected problem.</h1><p>Your data has not been changed. Return to the dashboard and try again.</p></div>
        <div class="auth-brand__footer">District Operations Ltd</div>
    </aside>
    <main class="auth-panel">
        <section class="auth-card success-card">
            <a href="/" class="auth-mobile-logo"><img src="~/Images/Logo.png" alt="Waman" width="150" height="57" /></a>
            <span class="success-card__icon error-card__icon"><i class="ph ph-warning-circle ui-icon"></i></span>
            <span class="auth-card__eyebrow">Something went wrong</span>
            <h2>Unable to complete the request</h2>
            <p class="auth-card__intro">Please return to the dashboard and retry. If the issue persists, contact the administrator.</p>
            <a href="/Home/Dashboard" class="auth-submit auth-submit--link">Return to dashboard</a>
        </section>
    </main>
    @Html.Partial("_AppFooter")
</body>
</html>
