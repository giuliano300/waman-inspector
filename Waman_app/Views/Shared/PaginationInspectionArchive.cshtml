@{
    const int pageSize = 25;
    int totalItems = ViewBag.totalItems != null ? Convert.ToInt32(ViewBag.totalItems) : 0;
    int totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);
    int currentPage = 0;
    if (!string.IsNullOrWhiteSpace(Request.QueryString["page"]))
    {
        int.TryParse(Request.QueryString["page"], out currentPage);
    }
    currentPage = Math.Max(0, Math.Min(currentPage, Math.Max(0, totalPages - 1)));
    string year = Request.QueryString["year"];
    string month = Request.QueryString["month"];
    string locationName = Request.QueryString["locationName"];

    Func<int, string> pageUrl = index => Url.Action("InspectionArchive", "Home", new
    {
        locationName = locationName,
        year = year,
        month = month,
        page = index
    });
}

@if (totalPages > 1)
{
    int firstVisible = Math.Max(0, currentPage - 2);
    int lastVisible = Math.Min(totalPages - 1, currentPage + 2);

    <nav class="archive-pagination" aria-label="Archive pages">
        <a href="@pageUrl(currentPage - 1)" class="archive-pagination__arrow @(currentPage == 0 ? "is-disabled" : "")" aria-label="Previous page"><i class="ph ph-caret-left ui-icon"></i></a>

        @if (firstVisible > 0)
        {
            <a href="@pageUrl(0)">1</a>
            if (firstVisible > 1) { <span>&hellip;</span> }
        }

        @for (int index = firstVisible; index <= lastVisible; index++)
        {
            <a href="@pageUrl(index)" class="@(index == currentPage ? "is-active" : "")" aria-current="@(index == currentPage ? "page" : null)">@(index + 1)</a>
        }

        @if (lastVisible < totalPages - 1)
        {
            if (lastVisible < totalPages - 2) { <span>&hellip;</span> }
            <a href="@pageUrl(totalPages - 1)">@totalPages</a>
        }

        <a href="@pageUrl(currentPage + 1)" class="archive-pagination__arrow @(currentPage == totalPages - 1 ? "is-disabled" : "")" aria-label="Next page"><i class="ph ph-caret-right ui-icon"></i></a>
    </nav>
}
